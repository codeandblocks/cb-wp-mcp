# Code & Blocks WordPress MCP – Beispielkonfiguration
# In Coolify unter "Environment Variables" eintragen (nicht als Datei committen).

# Öffentliche Adresse des Servers (ohne /mcp am Ende)
PUBLIC_URL=https://mcp.deinedomain.de

# Passwort für die Anmeldeseite, wenn Claude (claude.ai / App) sich verbindet. Mind. 12 Zeichen.
ADMIN_PASSWORD=ein-langes-sicheres-passwort

# Optional: eigener Verschlüsselungsschlüssel (sonst /data/secret.key). Im Passwortmanager sichern.
# SECRET_KEY=

# Optional: statischer Token für den Betreiber-Bereich (Kunden erzeugen Tokens im Portal). Mind. 24 Zeichen.
# Erzeugen mit: openssl rand -hex 32
MCP_TOKEN=

# Ab Version 1.2 verbindest du Seiten in der Oberfläche unter /admin.
# Die folgenden WP_*-Variablen sind optional und werden beim Start einmalig übernommen.

# --- Eine einzelne WordPress-Seite ---
WP_URL=https://deine-wordpress-seite.de
WP_USER=claude
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WP_SITE_ID=default
# WP_REST_BASE=https://deine-wordpress-seite.de/?rest_route=   # nur ohne Permalinks nötig

# --- ODER mehrere Seiten (JSON, eine Zeile) ---
# WP_SITES=[{"id":"blog","url":"https://blog.de","user":"claude","appPassword":"xxxx xxxx xxxx xxxx xxxx xxxx"},{"id":"shop","url":"https://shop.de","user":"claude","appPassword":"yyyy yyyy yyyy yyyy yyyy yyyy"}]

# --- Stockbilder (optional) ---
# PEXELS_API_KEY=        # https://www.pexels.com/api/
# UNSPLASH_ACCESS_KEY=   # https://unsplash.com/oauth/applications

# --- Optional ---
# READ_ONLY=false              # true = nur lesende Tools
# ALLOW_TOKEN_IN_URL=false     # true = /mcp/<MCP_TOKEN> funktioniert ohne Header (Notlösung)
# MAX_UPLOAD_MB=50
# MAX_OUTPUT_CHARS=60000
# ACCESS_TOKEN_TTL_HOURS=168
# REFRESH_TOKEN_TTL_DAYS=180
# ALLOW_PRIVATE_FETCH=false    # true = upload_media darf interne Adressen laden
# TRUST_PROXY=1
# PORT=3000
# DATA_DIR=/data
